        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO conversaciones (cliente_id, mensaje, respuesta)\nVALUES (\n  (SELECT id FROM clientes WHERE telefono = '{{ $json.telefono }}' LIMIT 1),\n  '{{ $json.mensaje }}',\n  '{{ $json.respuesta }}'\n)",
          "options": {}
