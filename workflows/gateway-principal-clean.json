{
  "name": "Gateway V2 \u00e2\u20ac\u201d n8n como Gateway Ligero",
  "nodes": [
    {
      "id": "1bd94805-0ad5-432f-bf89-53b28f78a984",
      "name": "Webhook Evolution",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "path": "whatsapp-webhook",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "responseData": "allEntries",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "whatsapp-webhook-e24be2fc"
    },
    {
      "id": "9276d945-6d4d-4c96-a335-5f6242589eb5",
      "name": "Extraer y Sanitizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nlet telefono = '';\nlet mensaje = '';\nlet nombre = '';\nlet remoteJid = '';\n\nif (body.data) {\n  const key = body.data.key || {};\n  remoteJid = key.remoteJid || '';\n  telefono = remoteJid.split('@')[0];\n  mensaje = body.data.message?.conversation ||\n            body.data.message?.extendedTextMessage?.text ||\n            body.data.message?.imageMessage?.caption || '';\n  nombre = body.data.pushName || '';\n} else {\n  telefono = body.telefono || body.from || '';\n  mensaje = body.mensaje || body.message || body.text || '';\n  nombre = body.nombre || body.pushName || '';\n  remoteJid = telefono ? telefono + '@s.whatsapp.net' : '';\n}\n\n// Sanitizar\ntelefono = String(telefono).replace(/[^0-9]/g, '');\nmensaje = String(mensaje).trim().substring(0, 4096);\nnombre = String(nombre).trim().substring(0, 150);\n\nreturn [{\n  json: {\n    telefono: telefono,\n    mensaje: mensaje,\n    nombre: nombre || null,\n    remoteJid: remoteJid\n  }\n}];"
      }
    },
    {
      "id": "4e3e3513-9c9a-4a05-bd7b-021a65012444",
      "name": "Forward a FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/api/v1/messages",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "telefono",
              "value": "={{ $json.telefono }}"
            },
            {
              "name": "mensaje",
              "value": "={{ $json.mensaje }}"
            },
            {
              "name": "nombre",
              "value": "={{ $json.nombre }}"
            },
            {
              "name": "remoteJid",
              "value": "={{ $json.remoteJid }}"
            },
            {
              "name": "timestamp",
              "value": "={{ Date.now() }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "allowUnauthorizedCerts": true
        }
      }
    },
    {
      "id": "ed1b81e2-4e44-436e-b2f6-057686cffb0e",
      "name": "Enviar Respuesta WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://evolution:8080/message/sendText/timonws",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $node['Extraer y Sanitizar'].json.telefono }}"
            },
            {
              "name": "text",
              "value": "={{ $json.respuesta }}"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ process.env.AUTHENTICATION_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "5223c3c5-ac88-408d-be0c-929b1ff91d32",
      "name": "Responder Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, conversacion_id: $json.conversacion_id, categoria: $json.categoria }) }}"
      }
    }
  ],
  "connections": {
    "Webhook Evolution": {
      "main": [
        [
          {
            "node": "Extraer y Sanitizar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer y Sanitizar": {
      "main": [
        [
          {
            "node": "Forward a FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward a FastAPI": {
      "main": [
        [
          {
            "node": "Enviar Respuesta WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Respuesta WhatsApp": {
      "main": [
        [
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "executionOrder": "v1"
  },
  "staticData": null,
  "id": "43f20768-259c-476f-bd2a-32c1bf0d4f38"
}